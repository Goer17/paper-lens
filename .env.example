# Debug model (seeded into the Models list on the first run)
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# HOST=127.0.0.1
# PORT=8787
# APP_TOKEN=
# PAPER_READER_DATA=./server/data

# Docker published address: 127.0.0.1 (default, loopback) or 0.0.0.0 (public).
# Public HTTP exposes the access token; use a TLS reverse proxy.
# PAPERLENS_BIND=127.0.0.1

# Docker host port (inside the container the app always uses 8787).
# PAPERLENS_PORT=8787
